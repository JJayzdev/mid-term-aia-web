{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIA question bank v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bank_version",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "bank_version": {
      "$ref": "#/$defs/nonempty"
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "text": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "sha256",
        "pdf_page",
        "title",
        "verification"
      ],
      "properties": {
        "document_id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pdf_page": {
          "type": "integer",
          "minimum": 1
        },
        "printed_slide_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "$ref": "#/$defs/nonempty"
        },
        "locator": {
          "$ref": "#/$defs/nonempty"
        },
        "verification": {
          "enum": [
            "needs_review",
            "verified"
          ]
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "weight",
        "full_credit",
        "partial_credit",
        "no_credit"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "$ref": "#/$defs/nonempty"
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "full_credit": {
          "$ref": "#/$defs/nonempty"
        },
        "partial_credit": {
          "$ref": "#/$defs/nonempty"
        },
        "no_credit": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "reviewed_at",
        "reviewed_revision",
        "report_id"
      ],
      "properties": {
        "reviewer_id": {
          "$ref": "#/$defs/identifier"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewed_revision": {
          "type": "integer",
          "minimum": 1
        },
        "report_id": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "author_id",
        "phase",
        "track",
        "day",
        "topic",
        "taxonomy_status",
        "question_type",
        "answer_format",
        "difficulty",
        "cognitive_level",
        "question",
        "correct_answer",
        "explanation",
        "source_reference",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "author_id": {
          "$ref": "#/$defs/identifier"
        },
        "phase": {
          "enum": [
            1,
            2,
            null
          ]
        },
        "track": {
          "enum": [
            1,
            2,
            3,
            4,
            null
          ]
        },
        "day": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "topic": {
          "$ref": "#/$defs/identifier"
        },
        "taxonomy_status": {
          "enum": [
            "unresolved",
            "inferred",
            "verified"
          ]
        },
        "question_type": {
          "enum": [
            "single_choice",
            "multiple_choice",
            "true_false",
            "short_answer",
            "scenario",
            "matching",
            "ordering"
          ]
        },
        "answer_format": {
          "enum": [
            "single_choice",
            "multiple_choice",
            "boolean",
            "rubric",
            "matching",
            "ordering"
          ]
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "cognitive_level": {
          "enum": [
            "remember",
            "understand",
            "apply",
            "analyze"
          ]
        },
        "question": {
          "$ref": "#/$defs/nonempty"
        },
        "context": {
          "$ref": "#/$defs/nonempty"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "shuffle_options": {
          "type": "boolean"
        },
        "correct_answer": {},
        "rubric": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "explanation": {
          "$ref": "#/$defs/nonempty"
        },
        "source_reference": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "status": {
          "enum": [
            "draft",
            "pending_review",
            "approved",
            "rejected"
          ]
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "review_notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "calculation": {
          "type": "boolean",
          "description": "Quantitative application with numerical work; optional for older questions."
        },
        "matching_items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/matching_item"
          }
        },
        "matching_reuse": {
          "type": "boolean",
          "default": false
        },
        "accepted_orders": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "focus_topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "react",
              "generation",
              "kalman",
              "sensors",
              "closed-loop",
              "activations",
              "normalization"
            ]
          }
        },
        "formula_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "formula",
            "symbols",
            "conditions",
            "example",
            "common_mistakes"
          ],
          "properties": {
            "title": {
              "$ref": "#/$defs/nonempty"
            },
            "formula": {
              "$ref": "#/$defs/nonempty"
            },
            "symbols": {
              "$ref": "#/$defs/nonempty"
            },
            "conditions": {
              "$ref": "#/$defs/nonempty"
            },
            "example": {
              "$ref": "#/$defs/nonempty"
            },
            "common_mistakes": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        "supplemental_sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/supplemental_source"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "track": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": 2
              }
            }
          },
          "then": {
            "properties": {
              "track": {
                "enum": [
                  1,
                  2,
                  3,
                  4
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "question_type": {
                "const": "single_choice"
              }
            }
          },
          "then": {
            "properties": {
              "answer_format": {
                "const": "single_choice"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "question_type": {
                "const": "multiple_choice"
              }
            }
          },
          "then": {
            "properties": {
              "answer_format": {
                "const": "multiple_choice"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "question_type": {
                "const": "true_false"
              }
            }
          },
          "then": {
            "properties": {
              "answer_format": {
                "const": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "question_type": {
                "const": "short_answer"
              }
            }
          },
          "then": {
            "properties": {
              "answer_format": {
                "const": "rubric"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "question_type": {
                "const": "scenario"
              }
            }
          },
          "then": {
            "required": [
              "context"
            ],
            "properties": {
              "answer_format": {
                "enum": [
                  "single_choice",
                  "multiple_choice",
                  "rubric"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answer_format": {
                "const": "single_choice"
              }
            }
          },
          "then": {
            "required": [
              "options",
              "shuffle_options"
            ],
            "properties": {
              "correct_answer": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answer_format": {
                "const": "multiple_choice"
              }
            }
          },
          "then": {
            "required": [
              "options",
              "shuffle_options"
            ],
            "properties": {
              "options": {
                "minItems": 3
              },
              "correct_answer": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answer_format": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "correct_answer": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answer_format": {
                "const": "rubric"
              }
            }
          },
          "then": {
            "required": [
              "rubric"
            ],
            "properties": {
              "correct_answer": {
                "$ref": "#/$defs/nonempty"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "rubric"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "answer_format": {
                "enum": [
                  "boolean",
                  "rubric"
                ]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "options"
                  ]
                },
                {
                  "required": [
                    "shuffle_options"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "required": [
              "review"
            ],
            "properties": {
              "phase": {
                "enum": [
                  1,
                  2
                ]
              },
              "taxonomy_status": {
                "const": "verified"
              },
              "source_reference": {
                "items": {
                  "properties": {
                    "verification": {
                      "const": "verified"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "question_type": {
                "const": "matching"
              }
            }
          },
          "then": {
            "properties": {
              "answer_format": {
                "const": "matching"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answer_format": {
                "const": "matching"
              }
            }
          },
          "then": {
            "required": [
              "options",
              "shuffle_options",
              "matching_items"
            ],
            "properties": {
              "question_type": {
                "const": "matching"
              },
              "shuffle_options": {
                "const": true
              },
              "correct_answer": {
                "type": "object",
                "minProperties": 2,
                "propertyNames": {
                  "$ref": "#/$defs/identifier"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "question_type": {
                "const": "ordering"
              }
            }
          },
          "then": {
            "properties": {
              "answer_format": {
                "const": "ordering"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answer_format": {
                "const": "ordering"
              }
            }
          },
          "then": {
            "required": [
              "options",
              "shuffle_options"
            ],
            "properties": {
              "question_type": {
                "const": "ordering"
              },
              "shuffle_options": {
                "const": true
              },
              "correct_answer": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answer_format": {
                "not": {
                  "const": "matching"
                }
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "matching_items"
                  ]
                },
                {
                  "required": [
                    "matching_reuse"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "answer_format": {
                "not": {
                  "const": "ordering"
                }
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "accepted_orders"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "matching_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "text": {
          "$ref": "#/$defs/nonempty"
        },
        "explanation": {
          "$ref": "#/$defs/nonempty"
        },
        "graph": {
          "type": "string",
          "enum": [
            "sigmoid",
            "tanh",
            "relu"
          ]
        }
      }
    },
    "supplemental_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "accessed_at",
        "note"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonempty"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s/?#]+(?:[/?#]|$)"
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "$ref": "#/$defs/nonempty"
        }
      }
    }
  }
}
